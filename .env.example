NEUROANNOTATE_DATA_DIR=/app/data
NEUROANNOTATE_DATABASE_URL=sqlite:////app/data/neuroannotate.db
# Default CPU/demo deployment. Set `deepisles` only with `docker compose --profile gpu up`; the GPU service uses the maintained BrainLesion stroke_segmentor implementation.
NEUROANNOTATE_INFERENCE_PROVIDER=demo
NEUROANNOTATE_DEEPISLES_URL=http://deepisles:8080
# Host directory mounted at /app/data. Override for isolated validation data.
NEUROANNOTATE_HOST_DATA_DIR=./data
NEUROANNOTATE_MAX_UPLOAD_MB=2048
NEUROANNOTATE_FRONTEND_ORIGIN=http://localhost:5173
NEUROANNOTATE_SAMPLE_DATA_DIR=/app/sample_data
